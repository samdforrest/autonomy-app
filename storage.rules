rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Thumbnail images - public read/write for admin uploads
    match /thumbnails/{videoId} {
      allow read: if true;
      allow write: if true;
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
